load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "laine_tomlin",
    srcs = ["solver.cc"],
    hdrs = ["solver.h"],
    visibility = ["//visibility:public"],
    deps = ["@eigen//:eigen"],
)

cc_binary(
    name = "compare",
    testonly = True,
    srcs = [
        "fixture_audit.h",
        "fixture_test.cc",
        "problem_conversion.h",
        "test_problem.h",
    ],
    tags = ["manual"],
    target_compatible_with = select({
        "//:fp32": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [":laine_tomlin", "//:adversarial_test_support"],
)

cc_library(
    name = "comparison_support",
    testonly = True,
    hdrs = ["problem_conversion.h", "test_problem.h"],
    visibility = ["//:__pkg__"],
    deps = [":laine_tomlin", "//:clqr"],
)

cc_test(
    name = "solver_test",
    size = "small",
    srcs = ["solver_test.cc", "test_problem.h"],
    deps = [":laine_tomlin"],
)

cc_test(
    name = "fixture_test",
    size = "medium",
    srcs = [
        "fixture_audit.h",
        "fixture_test.cc",
        "problem_conversion.h",
        "test_problem.h",
    ],
    # The independent implementation is FP64; do not compare against rounded
    # FP32 fixtures or silently attribute FP32 timings to it.
    target_compatible_with = select({
        "//:fp32": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [":laine_tomlin", "//:adversarial_test_support"],
)
